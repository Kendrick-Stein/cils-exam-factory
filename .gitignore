# Local copies of official CILS papers — copyrighted, never publish
reference/

# OS / editor noise
.DS_Store
*.swp
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# Local Claude Code settings
.claude/settings.local.json

# Scratch space used by pipeline runs
work/

# Per-session dispatch scratch: prompts fed to executors, job logs and the
# pre-repair fragment backups. All regenerable, none read by any script —
# a session's record is manifest.yaml + blind-validation.json + the audits.
papers/*/s1-prompts/
papers/*/s2-prompts/
papers/*/s4-prompts/
papers/*/s?-prompt-*.txt
papers/*/s?-tasks.txt
papers/*/s2-glossario-tasks.txt
papers/*/s2-replies.txt
papers/*/s4-repair-tasks.txt
papers/*/used-sources.txt
papers/*/*.sh
papers/*/gen_s2_prompts.py
papers/*/update_manifests.py
papers/**/*.txt.log
papers/**/*.json.r[0-9]

# Agent-runtime dirs generated by other CLIs / plugins, not project config
.agents/
.codex/agents/
.superpowers/
